# Flight Status — configuration
# Copy this file to .env and fill in your keys.

# FlightAware AeroAPI key (primary source).
# https://www.flightaware.com/aeroapi/portal
AEROAPI_KEY=

# airframes.io API key (optional fallback source).
# https://app.airframes.io  — leave blank to use anonymous access.
AIRFRAMES_API_KEY=

# Secret used to sign the session cookie. Change to a long random string.
SECRET_KEY=change-me-to-a-long-random-string

# --- Refresh tuning (optional) ---
# How often a flight is re-queried, depending on how close it is (seconds).
# The values below are deliberately conservative to stay inside the
# AeroAPI personal plan ($5/month, 10 queries/minute).
REFRESH_FAR_SECONDS=86400      # more than 48h before departure
REFRESH_NEAR_SECONDS=21600     # 12-48h before departure
REFRESH_SOON_SECONDS=7200      # 3-12h before departure
REFRESH_IMMINENT_SECONDS=3600  # 1-3h before departure
REFRESH_ACTIVE_SECONDS=600     # less than 1h before departure / in flight
REFRESH_STALE_SECONDS=1800     # departure passed, still no arrival data
REFRESH_UNKNOWN_SECONDS=3600   # no timing data available yet

# Minimum gap between two AeroAPI calls (AeroAPI allows 10/min).
AEROAPI_MIN_INTERVAL_SECONDS=7

# Hard stop: maximum AeroAPI calls per UTC day. Protects your monthly credit.
AEROAPI_MAX_DAILY_CALLS=30

# --- Email alerts (optional) ---
# Sends an email when a tracked flight's status, gate/terminal changes, and a
# reminder before departure. Uses SMTP; Gmail works with an App Password
# (https://myaccount.google.com/apppasswords — requires 2-Step Verification).
# Leave MAIL_HOST blank to disable alerts entirely.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@gmail.com
# App password. The spaces Google prints between the 4-character groups are
# ignored, so paste it either way.
MAIL_PASSWORD=
# Overrides the visible From address (defaults to MAIL_USERNAME).
MAIL_FROM=
MAIL_FROM_NAME=Flight Status
# Fallback recipient when a tracked flight's owner has no email in .users.
# Defaults to MAIL_FROM, then MAIL_USERNAME.
MAIL_TO=

# Minutes before departure to send the "leaving soon" reminder.
ALERT_LEAD_MINUTES=120
# Backoff between send retries (seconds) when SMTP errors out.
ALERT_RETRY_SECONDS=300
